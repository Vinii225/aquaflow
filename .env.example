# Copie para .env e preencha. O .env é lido automaticamente pela aplicação e não vai para o Git.

# Banco PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquaflow
DB_USER=aquaflow
DB_PASSWORD=aquaflow

# Opcionais
# PORT=8080                    # porta HTTP (o Render define sozinho)
# FLYWAY_ENABLED=true          # roda as migrations ao subir
# FLYWAY_BASELINE_VERSION=2    # versão assumida em banco já populado sem histórico do Flyway
# SHOW_SQL=false               # loga as queries do Hibernate
# THYMELEAF_CACHE=true         # recomendado em produção

# Pagamento online com Mercado Pago em modo de teste (sem token = pagamento simulado)
# MERCADOPAGO_ACCESS_TOKEN=    # Access Token de teste (Suas integrações > Credenciais de teste)
# MERCADOPAGO_WEBHOOK_SECRET=  # Assinatura secreta do webhook (Webhooks > Configurar notificações)
# APP_BASE_URL=                # URL pública com https, ex.: https://aquaflow-9h8a.onrender.com
