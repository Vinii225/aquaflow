# Copie para .env e preencha. O .env é lido automaticamente pela aplicação e não vai para o Git.

# Banco PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquaflow
DB_USER=aquaflow
DB_PASSWORD=aquaflow

# Opcionais
# PORT=8080                    # porta HTTP (o Render define sozinho)
# FLYWAY_ENABLED=true          # roda as migrations ao subir
# FLYWAY_BASELINE_VERSION=2    # versão assumida em banco já populado sem histórico do Flyway
# SHOW_SQL=false               # loga as queries do Hibernate
# THYMELEAF_CACHE=true         # recomendado em produção
